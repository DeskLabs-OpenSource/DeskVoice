// Fixture da cerca call-events-have-one-writer: insert direto na tabela, sem passar por
// `recordEvent` e sem conferir o vocabulário.
export async function grava(q: { exec(sql: string, params: unknown[]): Promise<number> }, id: string): Promise<void> {
  await q.exec("insert into call_events (organization_id, call_id, at, kind, payload) select organization_id, id, now(), 'inventado', '{}' from calls where id = $1", [id]);
}
