#!/usr/bin/env bash
# git de mentira: nenhum teste toca no git de verdade. Por padrão diz que a pasta não é um
# repositório. Com $FAKE_DIR/git_tags, faz as vezes de um clone limpo no ramo main cujas tags são
# as linhas desse arquivo, na ordem em que o git as devolveria (a maior primeiro); arquivo vazio
# é clone sem nenhuma versão. $FAKE_DIR/git_fetch_fail simula a rede fora do ar.
echo "git $*" >> "$FAKE_DIR/calls.log"
[ -f "$FAKE_DIR/git_tags" ] || exit 1
case " $* " in
  *" rev-parse --git-dir "*) echo .git ;;
  # O commit em que o clone está. Por padrão é o da versão que o instalador pedir (como quem chegou
  # pelo get.sh, ou foi levado pelo update.sh); com $FAKE_DIR/git_head é outro, como quem clonou à
  # mão e ficou na ponta da main.
  *" rev-parse HEAD "*) if [ -f "$FAKE_DIR/git_head" ]; then cat "$FAKE_DIR/git_head"; else echo commit-da-versao; fi ;;
  *" rev-parse refs/tags/"*) echo commit-da-versao ;;
  *" rev-parse --verify "*) ref="${*: -1}"; grep -qx "${ref#refs/tags/}" "$FAKE_DIR/git_tags" ;;
  # Com $FAKE_DIR/git_tags_after_fetch, a consulta traz versões novas (uma tag publicada no meio).
  *" fetch "*) [ ! -f "$FAKE_DIR/git_fetch_fail" ] || exit 1; if [ -f "$FAKE_DIR/git_tags_after_fetch" ]; then mv "$FAKE_DIR/git_tags_after_fetch" "$FAKE_DIR/git_tags"; fi ;;
  *" tag --list "*) cat "$FAKE_DIR/git_tags" ;;
  *" status --porcelain "*) ;;
  *" symbolic-ref "*) echo main ;;
  # O arquivo de outra versão (`show <ref>:<caminho>`): o de $FAKE_DIR/git_checkout/<ref>/<caminho>.
  *" show "*) spec="${*: -1}"; cat "$FAKE_DIR/git_checkout/${spec%%:*}/${spec#*:}" 2>/dev/null ;;
  # Trocar o código: se o teste preparou $FAKE_DIR/git_checkout/<ref> e disse onde fica a cópia
  # de trabalho ($FAKE_GIT_WORKTREE), os arquivos de lá vão por cima dela, como numa troca de versão.
  *" checkout "*)
    ref="${*: -1}"; ref="${ref##*/}"
    if [ -n "${FAKE_GIT_WORKTREE:-}" ] && [ -d "$FAKE_DIR/git_checkout/$ref" ]; then cp -R "$FAKE_DIR/git_checkout/$ref/." "$FAKE_GIT_WORKTREE/"; fi ;;
  *) exit 1 ;;
esac
